# 배치 제출 기록 (로컬 상태)
.batch_jobs/

# 분석 결과물(생성되는 것)은 저장소에 두지 않는다.
# 다만 **원본 조사 데이터**는 예외다. 이게 없으면 다른 컴퓨터에서 클론해도
# 아무것도 못 한다. 실제로 쿠팡_11개카테고리_275개 엑셀이 이 규칙에 걸려
# 저장소에서 빠져 있었다. 생성물과 원본을 같은 규칙으로 묶으면 안 된다.
*.xlsx
!쿠팡_11개카테고리_275개_제품목록.xlsx
!쿠팡_150개_제품목록_URL.xlsx

# 캡처 이미지
images/

# 파이썬
venv/
__pycache__/
*.pyc

# 추출 결과 JSON은 data/extracted 에 보관 (재현 가능하도록 커밋)
!data/extracted/*.json

# Node 모듈
node_modules/

# 로컬 캡처 (브라우저 프로필·수집물은 저장소에 두지 않음)
local_capture/.browser_profile/
local_capture/captures/

# 배포용 묶음 (생성물)
*.zip
