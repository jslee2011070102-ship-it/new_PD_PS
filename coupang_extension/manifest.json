{
  "manifest_version": 3,
  "name": "쿠팡 상세페이지 이미지 수집기",
  "version": "1.12.1",
  "description": "제품명으로 쿠팡 주소를 찾고, 상세페이지 이미지를 모아 저장합니다. 사용자의 브라우저에서 동작합니다.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.coupang.com/*",
    "https://*.coupangcdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "쿠팡 상세페이지 이미지 수집기"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
